{
  "schema_version": "1.0.0",
  "upas_target_version": ">=1.0.0,<2.0.0",
  "project": {
    "name": "support_bot",
    "type": "application",
    "language": "python",
    "runtime_version": "3.11"
  },
  "zones": [
    {
      "name": "core_app",
      "paths": ["app/core/**", "app/utils/**"],
      "risk_level": "medium",
      "default_test_level": 1
    },
    {
      "name": "handlers_and_services",
      "paths": ["app/handlers/**", "app/services/**", "app/repositories/**"],
      "risk_level": "high",
      "default_test_level": 2
    },
    {
      "name": "db_layer",
      "paths": ["app/db/**"],
      "risk_level": "high",
      "default_test_level": 3
    }
  ],
  "test_engine": {
    "runner": "pytest",
    "level_commands": {
      "level_0": "python -m compileall app scripts tests",
      "level_1": "pytest tests/test_formatting.py tests/test_time.py tests/test_config.py -v",
      "level_2": "pytest tests/test_repositories.py tests/test_services.py -v",
      "level_3": "pytest tests/test_p0_messages.py tests/test_health.py -v",
      "level_4": "pytest tests/test_governance_scripts.py -v",
      "level_5": "pytest tests/ -v"
    },
    "test_map": [
      {
        "match": "app/utils/formatting.py",
        "tests": ["tests/test_formatting.py"],
        "escalate_to_level": 1
      },
      {
        "match": "app/services/",
        "tests": ["tests/test_services.py", "tests/test_repositories.py"],
        "escalate_to_level": 2
      },
      {
        "match": "app/handlers/",
        "tests": ["tests/test_p0_messages.py"],
        "escalate_to_level": 3
      }
    ],
    "escalation_triggers": {
      "database_migrations": 5,
      "database_schemas": 4,
      "api_contracts": 3,
      "runtime_configuration": 3,
      "dependency_manifests": 3,
      "infrastructure_manifests": 4,
      "security_sensitive_files": 4
    }
  },
  "artifact": {
    "type": "container_image",
    "builder": "docker_buildx",
    "registry": "ghcr.io/org/support-bot",
    "immutable_tag_format": "sha-{commit_short}"
  },
  "resource_gate": {
    "pre_flight_checks": {
      "min_free_ram_mb": 256,
      "max_swap_usage_pct": 60,
      "max_1m_load_average": 2.5,
      "min_free_disk_gb": 2.0
    }
  },
  "deployment": {
    "strategy": "immutable_pull",
    "target_host": "root@runode",
    "service_name": "support-bot",
    "runtime_directory": "/opt/support_bot",
    "compose_file": "docker-compose.yml"
  },
  "verification": {
    "health_check": {
      "type": "process_check",
      "command": "docker exec support-bot python -c 'import sys; sys.exit(0)'",
      "timeout_seconds": 10,
      "max_retries": 6,
      "retry_interval_seconds": 5
    }
  },
  "backup": {
    "type": "file_snapshot",
    "engine_hook": "scripts/init_db.py",
    "retention_count": 30,
    "checkpoint_dir": "/opt/support_bot/backups"
  },
  "migration": {
    "classification_policy": "explicit_manifest",
    "default_classification": "ADDITIVE_COMPATIBLE",
    "two_phase_protocol": true,
    "pre_deploy_hook": "python -m app.db.migrations"
  },
  "authorization": {
    "provider": "github_environment_oidc",
    "environment_name": "production",
    "expected_issuer": "https://token.actions.githubusercontent.com",
    "expected_audience": "upas-production-gate",
    "required_claims": ["repository", "environment", "ref", "job_workflow_ref"]
  }
}
