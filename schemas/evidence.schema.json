{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.upas.dev/v1/evidence.schema.json",
  "title": "UPAS Evidence Audit Record Schema",
  "description": "Immutable machine-readable audit record of automated operations in UPAS. This record proves execution evidence, referencing external authoritative sources of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "operation_id",
    "correlation_id",
    "project",
    "authoritative_sources",
    "steps",
    "final_verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Version of the Evidence schema."
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "deployment_audit_record",
        "release_precheck_record",
        "rollback_audit_record",
        "verification_audit_record"
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-zA-Z0-9_\\-\\.]+$",
      "description": "Unique identifier for this operation."
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^rel_[a-zA-Z0-9_\\-\\.]+$",
      "description": "Correlation identifier linking this operation to its Release Lifecycle instance."
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "adapter_version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["application", "library", "infrastructure"] },
        "adapter_version": { "type": "string", "minLength": 1 }
      }
    },
    "authoritative_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_dag",
        "ci_execution",
        "artifact_provenance",
        "production_authorization",
        "host_runtime"
      ],
      "properties": {
        "git_dag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit_sha", "branch", "dirty_tree"],
          "properties": {
            "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "branch": { "type": "string", "minLength": 1 },
            "dirty_tree": { "type": "boolean" }
          }
        },
        "ci_execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "run_id", "conclusion"],
          "properties": {
            "provider": { "type": "string", "enum": ["github_actions"] },
            "run_id": { "type": "string", "minLength": 1 },
            "workflow_ref": { "type": "string" },
            "conclusion": { "type": "string", "enum": ["success", "failure", "cancelled"] }
          }
        },
        "artifact_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["immutable_digest", "canonical_reference", "verified_running_digest"],
          "properties": {
            "immutable_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "canonical_reference": { "type": "string", "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$" },
            "verified_running_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "production_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "actor", "run_id", "environment", "approval_timestamp"],
          "properties": {
            "policy": {
              "type": "string",
              "enum": ["github_environment_oidc", "emergency_manual_token"]
            },
            "actor": { "type": "string", "minLength": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "environment": { "type": "string", "minLength": 1 },
            "approval_timestamp": { "type": "string", "format": "date-time" },
            "oidc_claims": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "host_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_identity", "kernel_timestamp", "lock_state"],
          "properties": {
            "host_identity": { "type": "string", "minLength": 1 },
            "kernel_timestamp": { "type": "string", "format": "date-time" },
            "lock_state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lock_acquired", "lock_path", "lock_owner_pid"],
              "properties": {
                "lock_acquired": { "type": "boolean" },
                "lock_path": { "type": "string", "pattern": "^/.*" },
                "lock_owner_pid": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "exit_code", "duration_ms"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "final_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "exit_code", "completed_at", "total_duration_ms"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "ROLLED_BACK",
            "EMERGENCY_HALT",
            "FAILED_PREFLIGHT",
            "FAILED_BACKUP",
            "FAILED_PULL",
            "BLOCKED_CONCURRENCY",
            "MIGRATION_FAILED",
            "DIGEST_MISMATCH",
            "APPROVAL_DENIED",
            "PROD_AUTH_FAILED",
            "UNKNOWN_REMOTE_STATE",
            "CANCELLED"
          ]
        },
        "exit_code": { "type": "integer" },
        "completed_at": { "type": "string", "format": "date-time" },
        "total_duration_ms": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string" }
      }
    }
  }
}
