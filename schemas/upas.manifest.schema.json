{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.upas.dev/v1/upas.manifest.schema.json",
  "title": "UPAS Capability Manifest Schema",
  "description": "Authoritative machine-readable specification of UPAS Core capabilities, supported schemas, CLI commands, and documentation requirements. Used by 'upas validate-docs' to prevent documentation drift.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_version",
    "supported_schema_versions",
    "cli_commands",
    "capabilities",
    "documentation_contract",
    "security_invariants"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"],
      "description": "Version of the UPAS Manifest schema."
    },
    "core_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-zA-Z0-9_\\-\\.]+)?$",
      "description": "SemVer of the UPAS Core release."
    },
    "supported_schema_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "evidence", "artifact", "manifest"],
      "properties": {
        "adapter": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "artifact": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "manifest": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "cli_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "description", "lifecycle_binding"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "arguments": {
            "type": "array",
            "items": { "type": "string" }
          },
          "lifecycle_binding": {
            "type": "string",
            "enum": ["change", "release", "deployment", "governance", "utility"]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status", "enforcement_type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_\\-\\.]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["active", "experimental", "deprecated"]
          },
          "enforcement_type": {
            "type": "string",
            "enum": [
              "host_guard",
              "workflow_engine",
              "cli_local",
              "schema_validation"
            ]
          }
        }
      }
    },
    "documentation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_documents"],
      "properties": {
        "required_documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filename", "purpose", "mandatory_for_agent_read"],
            "properties": {
              "filename": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "mandatory_for_agent_read": { "type": "boolean" }
            }
          }
        }
      }
    },
    "security_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zero_bypass_enforced",
        "immutable_digest_enforced",
        "host_lock_enforced",
        "migration_safety_enforced"
      ],
      "properties": {
        "zero_bypass_enforced": { "type": "boolean", "enum": [true] },
        "immutable_digest_enforced": { "type": "boolean", "enum": [true] },
        "host_lock_enforced": { "type": "boolean", "enum": [true] },
        "migration_safety_enforced": { "type": "boolean", "enum": [true] }
      }
    }
  }
}
